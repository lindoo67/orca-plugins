{
  "manifestVersion": 2,
  "id": "orca-gruvbox-theme",
  "publisher": "stablyai",
  "name": "Gruvbox for Orca",
  "version": "1.0.0",
  "execution": "data",
  "description": "Retro warm dark and light application themes, with matching Gruvbox terminal colors.",
  "license": "MIT",
  "repository": "https://github.com/stablyai/orca-plugins/tree/main/plugins/gruvbox-theme",
  "engines": {
    "orca": ">=1.4.244"
  },
  "contributes": {
    "themes": [
      {
        "id": "gruvbox-dark",
        "title": "Gruvbox Dark",
        "path": "themes/gruvbox-dark.json"
      },
      {
        "id": "gruvbox-light",
        "title": "Gruvbox Light",
        "path": "themes/gruvbox-light.json"
      }
    ],
    "terminalThemes": [
      {
        "id": "gruvbox-dark",
        "title": "Gruvbox Dark",
        "path": "terminal/gruvbox-dark.json"
      },
      {
        "id": "gruvbox-light",
        "title": "Gruvbox Light",
        "path": "terminal/gruvbox-light.json"
      }
    ]
  },
  "capabilities": [],
  "cover": {
    "path": "images/cover.png",
    "alt": "Gruvbox theme preview with a file tree, syntax-highlighted TypeScript, terminal output, and palette swatches"
  }
}
