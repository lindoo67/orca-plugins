{
  "base": "dark",
  "tokens": {
    "--background": "#282828",
    "--editor-surface": "#282828",
    "--foreground": "#ebdbb2",
    "--card": "#32302f",
    "--card-foreground": "#ebdbb2",
    "--popover": "#282828",
    "--popover-foreground": "#ebdbb2",
    "--primary": "#fabd2f",
    "--primary-foreground": "#282828",
    "--secondary": "#32302f",
    "--secondary-foreground": "#ebdbb2",
    "--muted": "#32302f",
    "--muted-foreground": "#a89984",
    "--accent": "#504945",
    "--accent-foreground": "#ebdbb2",
    "--border": "#665c54",
    "--input": "#665c54",
    "--ring": "#fabd2f",
    "--sidebar": "#1d2021",
    "--sidebar-foreground": "#ebdbb2",
    "--sidebar-accent": "#504945",
    "--sidebar-accent-foreground": "#ebdbb2",
    "--sidebar-border": "#665c54",
    "--sidebar-ring": "#fabd2f"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#928374",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "support.variable"
      ],
      "settings": {
        "foreground": "#ebdbb2"
      }
    },
    {
      "name": "Constants",
      "scope": [
        "constant",
        "support.constant",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#d3869b"
      }
    },
    {
      "name": "Numbers",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#d3869b"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "variable.language"
      ],
      "settings": {
        "foreground": "#fb4934"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#fb4934"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "punctuation.definition.string",
        "markup.inline.raw",
        "markup.raw"
      ],
      "settings": {
        "foreground": "#b8bb26"
      }
    },
    {
      "name": "Escapes and regular expressions",
      "scope": [
        "constant.character.escape",
        "string.regexp"
      ],
      "settings": {
        "foreground": "#d3869b"
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#b8bb26"
      }
    },
    {
      "name": "Types",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.namespace",
        "entity.other.inherited-class",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#fabd2f"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#ebdbb2"
      }
    },
    {
      "name": "Tags",
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#fb4934"
      }
    },
    {
      "name": "Attributes and keys",
      "scope": [
        "entity.other.attribute-name",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#8ec07c"
      }
    },
    {
      "name": "Decorators",
      "scope": [
        "meta.decorator",
        "entity.name.function.decorator"
      ],
      "settings": {
        "foreground": "#b8bb26"
      }
    },
    {
      "name": "Headings",
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#fabd2f",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "name": "Italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "name": "Links",
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#fabd2f",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Quotes",
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#928374",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid"
      ],
      "settings": {
        "foreground": "#fb4934"
      }
    }
  ]
}
