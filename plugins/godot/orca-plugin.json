{
  "manifestVersion": 2,
  "publisher": "stablyai",
  "version": "1.0.0",
  "execution": "data",
  "license": "MIT",
  "engines": {
    "orca": ">=1.4.245"
  },
  "capabilities": [],
  "id": "orca-godot",
  "name": "Godot Syntax",
  "description": "Syntax highlighting for GDScript, Godot resources and shaders.",
  "repository": "https://github.com/stablyai/orca-plugins/tree/main/plugins/godot",
  "contributes": {
    "syntaxes": [
      {
        "id": "gdscript",
        "title": "GDScript",
        "scopeName": "source.gdscript",
        "path": "syntaxes/gdscript.tmLanguage.json",
        "configuration": "syntaxes/gdscript-configuration.json",
        "extensions": [
          ".gd"
        ]
      },
      {
        "id": "gdresource",
        "title": "Godot Resource",
        "scopeName": "source.gdresource",
        "path": "syntaxes/gdresource.tmLanguage.json",
        "configuration": "syntaxes/gdresource-configuration.json",
        "extensions": [
          ".tscn",
          ".tres",
          ".escn",
          ".godot",
          ".import",
          ".remap",
          ".gdextension"
        ]
      },
      {
        "id": "gdshader",
        "title": "Godot Shader",
        "scopeName": "source.gdshader",
        "path": "syntaxes/gdshader.tmLanguage.json",
        "configuration": "syntaxes/gdshader-configuration.json",
        "extensions": [
          ".gdshader",
          ".gdshaderinc"
        ]
      }
    ]
  }
}
