{
  "manifestVersion": 2,
  "id": "orca-solarized-light-theme",
  "publisher": "stablyai",
  "name": "Solarized Light for Orca",
  "version": "1.0.1",
  "execution": "data",
  "description": "A warm cream application theme based on Ethan Schoonover's Solarized Light palette, with matching terminal colors.",
  "license": "MIT",
  "repository": "https://github.com/stablyai/orca-plugins/tree/main/plugins/solarized-light-theme",
  "engines": {
    "orca": ">=1.4.245"
  },
  "contributes": {
    "themes": [
      {
        "id": "solarized-light",
        "title": "Solarized Light",
        "path": "themes/solarized-light.json"
      }
    ],
    "terminalThemes": [
      {
        "id": "solarized-light",
        "title": "Solarized Light",
        "path": "terminal/solarized-light.json"
      }
    ]
  },
  "capabilities": [],
  "cover": {
    "path": "images/cover.png",
    "alt": "Solarized Light theme preview with a file tree, syntax-highlighted TypeScript, terminal output, and palette swatches"
  }
}
