{
  "manifestVersion": 2,
  "id": "orca-github-light-theme",
  "publisher": "stablyai",
  "name": "GitHub Light for Orca",
  "version": "1.0.0",
  "execution": "data",
  "description": "A crisp white application theme inspired by GitHub's default light palette, with matching terminal colors.",
  "license": "MIT",
  "repository": "https://github.com/stablyai/orca-plugins/tree/main/plugins/github-light-theme",
  "engines": {
    "orca": ">=1.4.244"
  },
  "contributes": {
    "themes": [
      {
        "id": "github-light",
        "title": "GitHub Light",
        "path": "themes/github-light.json"
      }
    ],
    "terminalThemes": [
      {
        "id": "github-light",
        "title": "GitHub Light",
        "path": "terminal/github-light.json"
      }
    ]
  },
  "capabilities": []
}
