{
  "manifestVersion": 2,
  "id": "orca-nord-theme",
  "publisher": "stablyai",
  "name": "Nord for Orca",
  "version": "2.1.0",
  "execution": "data",
  "description": "A cool, low-contrast application theme inspired by arctic colors.",
  "license": "MIT",
  "repository": "https://github.com/stablyai/orca-plugins/tree/main/plugins/nord-theme",
  "engines": {
    "orca": ">=1.4.242"
  },
  "contributes": {
    "themes": [
      {
        "id": "nord",
        "label": "Nord",
        "path": "themes/nord.json"
      }
    ]
  },
  "capabilities": [],
  "cover": {
    "path": "images/cover.png",
    "alt": "The Nord theme on an editor with a file tree and a TypeScript file"
  },
  "screenshots": [
    {
      "path": "images/editor.png",
      "alt": "Nord on the editor and terminal",
      "caption": "Editor and terminal"
    },
    {
      "path": "images/settings.png",
      "alt": "Nord selected in Appearance settings",
      "caption": "Appearance settings"
    }
  ]
}
