{
  "name": "Prisma",
  "scopeName": "source.prisma",
  "patterns": [
    { "include": "#comment" },
    { "include": "#block" },
    { "include": "#attribute" },
    { "include": "#string" },
    { "include": "#number" },
    { "include": "#type" },
    { "include": "#constant" }
  ],
  "repository": {
    "comment": {
      "patterns": [
        { "name": "comment.line.documentation.prisma", "match": "///.*$" },
        { "name": "comment.line.double-slash.prisma", "match": "//.*$" }
      ]
    },
    "block": {
      "match": "^\\s*(model|enum|type|view|datasource|generator)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "keyword.declaration.prisma" },
        "2": { "name": "entity.name.type.prisma" }
      }
    },
    "attribute": {
      "match": "(@@?[A-Za-z_][A-Za-z0-9_.]*)",
      "name": "entity.name.function.attribute.prisma"
    },
    "string": {
      "name": "string.quoted.double.prisma",
      "begin": "\"",
      "end": "\"",
      "patterns": [{ "name": "constant.character.escape.prisma", "match": "\\\\." }]
    },
    "number": {
      "name": "constant.numeric.prisma",
      "match": "\\b-?[0-9]+(?:\\.[0-9]+)?\\b"
    },
    "type": {
      "name": "support.type.prisma",
      "match": "\\b(String|Boolean|Int|BigInt|Float|Decimal|DateTime|Json|Bytes|Unsupported)\\b\\??\\[?\\]?"
    },
    "constant": {
      "name": "constant.language.prisma",
      "match": "\\b(true|false|null|now|autoincrement|uuid|cuid|env|dbgenerated)\\b"
    }
  }
}
