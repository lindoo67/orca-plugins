{
  "base": "dark",
  "tokens": {
    "--background": "#000000",
    "--editor-surface": "#000000",
    "--foreground": "#e6e6e6",
    "--card": "#000000",
    "--card-foreground": "#e6e6e6",
    "--popover": "#000000",
    "--popover-foreground": "#e6e6e6",
    "--primary": "#e6e6e6",
    "--primary-foreground": "#000000",
    "--secondary": "#141414",
    "--secondary-foreground": "#e6e6e6",
    "--muted": "#0f0f0f",
    "--muted-foreground": "#a3a3a3",
    "--accent": "#1a1a1a",
    "--accent-foreground": "#f5f5f5",
    "--border": "#1f1f1f",
    "--input": "#2a2a2a",
    "--ring": "#8c8c8c",
    "--sidebar": "#000000",
    "--sidebar-foreground": "#e6e6e6",
    "--sidebar-primary": "#e6e6e6",
    "--sidebar-primary-foreground": "#000000",
    "--sidebar-accent": "#1a1a1a",
    "--sidebar-accent-foreground": "#f5f5f5",
    "--sidebar-border": "#1f1f1f",
    "--sidebar-ring": "#8c8c8c",
    "--worktree-sidebar": "#000000",
    "--worktree-sidebar-foreground": "#e6e6e6",
    "--worktree-sidebar-accent": "#1a1a1a",
    "--worktree-sidebar-accent-foreground": "#f5f5f5",
    "--worktree-sidebar-border": "#1f1f1f",
    "--worktree-sidebar-ring": "#8c8c8c"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#8c8c8c",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "variable.language"
      ],
      "settings": {
        "foreground": "#c7a8ff"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#b3b3b3"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "punctuation.definition.string",
        "markup.inline.raw",
        "markup.raw"
      ],
      "settings": {
        "foreground": "#9ee39e"
      }
    },
    {
      "name": "Escapes and regular expressions",
      "scope": [
        "constant.character.escape",
        "string.regexp"
      ],
      "settings": {
        "foreground": "#ffd479"
      }
    },
    {
      "name": "Numbers",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#ffb070"
      }
    },
    {
      "name": "Constants",
      "scope": [
        "constant",
        "support.constant",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#ffb070"
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#7cc4ff"
      }
    },
    {
      "name": "Types",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.namespace",
        "entity.other.inherited-class",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#6fe0d0"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "variable.parameter",
        "support.variable"
      ],
      "settings": {
        "foreground": "#e6e6e6"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#a3a3a3"
      }
    },
    {
      "name": "Tags",
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#c7a8ff"
      }
    },
    {
      "name": "Attributes and keys",
      "scope": [
        "entity.other.attribute-name",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#6fe0d0"
      }
    },
    {
      "name": "Decorators",
      "scope": [
        "meta.decorator",
        "entity.name.function.decorator"
      ],
      "settings": {
        "foreground": "#ffd479"
      }
    },
    {
      "name": "Headings",
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#7cc4ff",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "name": "Italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "name": "Links",
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#6fe0d0",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Quotes",
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#8c8c8c",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid"
      ],
      "settings": {
        "foreground": "#ff6b6b"
      }
    }
  ]
}
